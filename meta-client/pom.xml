<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	
    <parent>
        <groupId>edu.utexas.tacc.tapis</groupId>
        <artifactId>tapis-client-java</artifactId>
        <version>2.0.166-SNAPSHOT</version>
    </parent>

	<artifactId>meta-client</artifactId>

	<name>Tapis Meta Client</name>
	<description>Java client for tapis-metaapi web application</description>

    <properties>
        <metaSpecPath>${project.basedir}/src/main/resources/metav3-openapi.yaml</metaSpecPath>
        <target.spec.format>yml</target.spec.format>
    </properties>

	<dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>shared-clientlib</artifactId>
            <version>${project.version}</version>
        </dependency>
	</dependencies>
    
	<build>
		<sourceDirectory>src/main/java</sourceDirectory>

	<plugins>
		<!-- Capture the git commit hash and branch identifiers. -->
		<!-- See parent pom for configuration details. -->
		<plugin>
			<groupId>org.codehaus.mojo</groupId>
			<artifactId>buildnumber-maven-plugin</artifactId>
		</plugin>

		<plugin>
			<!-- The version is set in the parent pom -->
			<groupId>org.apache.maven.plugins</groupId>
			<artifactId>maven-surefire-plugin</artifactId>
			<configuration>
				<suiteXmlFiles>
					<suiteXmlFile>src/test/resources/testng.xml</suiteXmlFile>
				</suiteXmlFiles>
			</configuration>
		</plugin>

        <!-- Extract artifact prefix before '-client' -->
        <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.4.0</version>
            <executions>
            <execution>
                <id>regex-property</id>
                <phase>initialize</phase>
                <goals>
                <goal>regex-property</goal>
                </goals>
                <configuration>
                <name>artifact.prefix</name>
                <value>${project.artifactId}</value>
                <regex>^([^-]+)-.*$</regex>
                <replacement>$1</replacement>
                <failIfNoMatch>false</failIfNoMatch>
                </configuration>
            </execution>
            </executions>
        </plugin>
        <!-- Run script to download latest app openapi_v3.yml and generate bundled json file  -->
        <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>${exec-maven-plugin.version}</version>
            <executions>
            <execution>
                <id>Generate bundled openapi json file</id>
                <phase>generate-sources</phase>
                <goals>
                <goal>exec</goal>
                </goals>
                <configuration>
                <executable>${basedir}/../gen_spec.sh</executable>
                <arguments>
                    <argument>${artifact.prefix}</argument>
                    <argument>${metaSpecPath}</argument>
                    <argument>${target.spec.format}</argument>
                </arguments>
                </configuration>
            </execution>
            </executions>
        </plugin>

        <!-- Build generated client code using openapi-generator -->
        <plugin>
            <groupId>org.openapitools</groupId>
            <artifactId>openapi-generator-maven-plugin</artifactId>
            <version>${openapi-generator-maven-plugin.version}</version>
            <executions>
                <execution>
                    <goals>
                        <goal>generate</goal>
                    </goals>
                    <configuration>
                        <inputSpec>${project.basedir}/target/openapi_v3.${target.spec.format}</inputSpec>
                        <enablePostProcessFile>true</enablePostProcessFile>
                        <output>${project.build.directory}/generated-sources/openapi</output>
                        <generatorName>java</generatorName>
                        <groupId>edu.utexas.tacc.tapis</groupId>
                        <invokerPackage>edu.utexas.tacc.tapis.meta.client.gen</invokerPackage>
                        <apiPackage>edu.utexas.tacc.tapis.meta.client.gen.api</apiPackage>
                        <modelPackage>edu.utexas.tacc.tapis.meta.client.gen.model</modelPackage>
                        <!-- Turn off generation of stuff we do not need -->
                        <generateApiTests>false</generateApiTests>
                        <generateApiDocumentation>false</generateApiDocumentation>
                        <generateModelTests>false</generateModelTests>
                        <generateModelDocumentation>false</generateModelDocumentation>
                        <configOptions>
                            <sourceFolder>src/gen/java/main</sourceFolder>
                            <!-- Use java 8 libraries instead of 3rd party libraries -->
                            <java8>true</java8>
                            <dateLibrary>java8</dateLibrary>
                        </configOptions>
                    </configuration>
                </execution>
            </executions>
        </plugin>
        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-shade-plugin</artifactId>
            <configuration>
                <createDependencyReducedPom>false</createDependencyReducedPom>
            </configuration>
            <executions>
                <execution>
                    <phase>package</phase>
                    <goals>
                        <goal>shade</goal>
                    </goals>
                </execution>
            </executions>
        </plugin>
    </plugins>
		<finalName>meta-client</finalName>
	</build>

</project>
