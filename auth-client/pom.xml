<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>edu.utexas.tacc.tapis</groupId>
    <artifactId>tapis-client-java</artifactId>
    <version>2.0.157-SNAPSHOT</version>
  </parent>

  <artifactId>auth-client</artifactId>

  <name>Tapis Authenticator Client</name>
  <description>Java client for Authenticator Service</description>

  <properties>
    <!-- Location of openapi spec. Default is dev branch -->
    <!-- NOTE: In order to try out openapi updates using a local file, just specify the file path like:
      file:///home/scblack/src_git/github/dev/tapis-client-java/auth-client/target/openapi_v3.yml
      mvn clean install
      mvn install -DauthSpecPath="file:///home/scblack/src_git/github/dev/tapis-client-java/auth-client/target/auth_spec.yaml"
          or if yaml committed to local branch then do:
      mvn install -DauthSpecPath="https://raw.githubusercontent.com/tapis-project/authenticator/dev/service/resources/openapi_v3.yml"
    -->
    <authSpecPath>https://raw.githubusercontent.com/tapis-project/authenticator/dev/service/resources/openapi_v3.yml</authSpecPath>

    <!-- Skip integration tests by default -->
    <!-- To run tests TAPIS_FILES_SVC_PASSWORD must be set in the env -->
    <!-- Use following command to run integration tests -->
    <!--   TAPIS_FILES_SVC_PASSWORD=<files_service_password> mvn verify -DskipIntegrationTests=false  -->
    <skipIntegrationTests>true</skipIntegrationTests>
  </properties>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>shared-clientlib</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.auth0</groupId>
      <artifactId>java-jwt</artifactId>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>src/main/java</sourceDirectory>
    
    <!-- NOTE: THE CALLED SCRIPT INTRODUCES HIDDEN DEPENDENCIES -->
    <!--       These dependencies include Docker and curl.      -->
    <plugins>
      <!-- Capture the git commit hash and branch identifiers. -->
      <!-- See parent pom for configuration details. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>buildnumber-maven-plugin</artifactId>
      </plugin>

      <plugin>
        <!-- The version is set in the parent pom -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <suiteXmlFiles>
            <suiteXmlFile>src/test/resources/testng.xml</suiteXmlFile>
          </suiteXmlFiles>
        </configuration>
      </plugin>
      <!-- Run script to download latest auth openapi_v3.yml and generate bundled json file  -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>Generate bundled openapi json file</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${basedir}/gen_spec.sh</executable>
              <arguments>
                <argument>${authSpecPath}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Build generated client code using openapi-generator -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator-maven-plugin.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/target/auth.json</inputSpec>
              <enablePostProcessFile>true</enablePostProcessFile>
              <generateAliasAsModel>true</generateAliasAsModel>
              <output>${project.build.directory}/generated-sources/openapi</output>
              <generatorName>java</generatorName>
              <groupId>edu.utexas.tacc.tapis</groupId>
              <invokerPackage>edu.utexas.tacc.tapis.auth.client.gen</invokerPackage>
              <apiPackage>edu.utexas.tacc.tapis.auth.client.gen.api</apiPackage>
              <modelPackage>edu.utexas.tacc.tapis.auth.client.gen.model</modelPackage>
              <generateApiTests>false</generateApiTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelTests>false</generateModelTests>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <sourceFolder>src/gen/java/main</sourceFolder>
                <dateLibrary>java8</dateLibrary>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>

    <finalName>auth-client</finalName>
  </build>

</project>
